#include <bits/stdc++.h>
using namespace std;
 
void solve() {
    string s;
    cin >> s;
 
    int n=s.size();
    int len=n;
    
    if(n%2!=0)  len--;
 
    for(int i=len ; i >0 ; i-=2)
    {
 
       
 
        for(int j=0 ; j<=(n-i) ; j++)
        {
 
             bool temp=true;
            for(int k= 0 ; k<(i/2) ; k++)
            {
                if(((s[j+k]) != s[j+k+(i/2)])  && s[j+k]!='?' && s[j+k+(i/2)]!='?')
                {
                    temp=false;
                    break;
                }
            }
 
            if(temp)
            {
                cout<<i<<endl;
                return ;
            }
        }
    }
 
 
    cout<<0<<endl;
}
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while(t--) {
        solve();
    }
    return 0;
}