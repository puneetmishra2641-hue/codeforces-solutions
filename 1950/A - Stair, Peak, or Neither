#include <bits/stdc++.h>
using namespace std;
 
void solve() {
    int a ,b,c;
    cin>>a>>b>>c;
    if(c>b && b>a)
    {
        cout<<"STAIR"<<endl;
        return;
    }
 
    if(b>a && b>c)
    {
        cout<<"PEAK"<<endl;
        return;
    }
 
    cout<<"NONE"<<endl;
}
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while(t--) {
        solve();
    }
    return 0;
}