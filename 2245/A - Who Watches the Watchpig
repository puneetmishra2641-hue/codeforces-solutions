#include <bits/stdc++.h>
using namespace std;
 
void solve() {
    int n ,k;
    cin >> n >> k ;
    string s ;
    cin >> s;
 
 
    if(n< (2*k))
    {
        cout<<-1<<endl;
        return;
    }
 
    int ans=0;
 
    for(int i=0 ; i<k ; i++)
    {
        if(s[i]=='L') ans++;
    }
 
    for(int i= n-1 ; i>=n-k;i--)
    {
        if(s[i]=='R')
        {
            ans++;
        }
    }
 
    cout<<ans<<endl;
}
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while(t--) {
        solve();
    }
    return 0;
}